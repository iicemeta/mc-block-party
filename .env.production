# =====================================================================
# 生产构建变量（astro build 默认 production 模式时自动加载）
# 本文件只含公开的前端 PUBLIC_* 变量（值会内联进公开的页面代码，无秘密），
# 因此可安全提交，GitHub 连接部署时无需再配置构建变量。
# 本地开发请复制 .env.example 为 .env（勿提交）。
# =====================================================================

# melody auth 服务地址（结尾不带斜杠）
PUBLIC_MCAUTH_SERVER_URI=https://auth.iicemeta.com

# melody auth Admin Panel 中为本站创建的 SPA 应用的 clientId
PUBLIC_MCAUTH_CLIENT_ID=03566153d5abd1ef459c5fab8d5124558E6C515f2D5DD09B60386205A7c57815

# 本站对外访问的基址（结尾不带斜杠），用于拼接登录回跳 /auth/callback 与登出跳转
PUBLIC_SITE_URI=https://blockparty.iicemeta.com
