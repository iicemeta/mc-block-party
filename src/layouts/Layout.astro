---
import "minecraft-react-ui/style.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const {
  title = "MC 联谊嘉年华 · 电脑技术协会 × 山商煤炭社",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="电脑技术协会 × 山商煤炭社 MC 联谊活动：报名、随机组队、晒图提交"
    />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main class="Page">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/click-sound";
    </script>
  </body>
</html>
