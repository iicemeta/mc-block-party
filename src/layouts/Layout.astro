---
import "minecraft-react-ui/style.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  /**
   * 是否允许弹出首访音效确认框。加载即会被重定向的瞬态页（登录回跳、旧登记页）
   * 应关闭：弹窗会被跳转打断而闪现失效；其余页面保持默认开启。
   */
  soundPrompt?: boolean;
}

const {
  title = "方块嘉年华 · MyGO!!!!! × 山商煤炭社",
  soundPrompt = true,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/img/items/golden_apple.png" />
    <meta
      name="description"
      content="MyGO!!!!! × 山商煤炭社 方块嘉年华第一期：报名、随机组队、晒图提交"
    />
    <title>{title}</title>
  </head>
  <body data-sound-defer={soundPrompt ? undefined : "1"}>
    <Navbar />
    <main class="Page">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/click-sound";
    </script>
  </body>
</html>
