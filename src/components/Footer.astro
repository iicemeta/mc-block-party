---
const year = new Date().getFullYear();
---

<footer class="Footer">
  <div class="Footer-clubs">
    <span class="club cyan">MyGO!!!!!</span>
    <img src="/img/items/golden_apple.png" alt="" width="20" height="20" class="pixel" />
    <span class="club coal">山商煤炭社</span>
  </div>
  <p>MC 联谊活动 · {year}</p>
  <p class="Footer-team">开发团队：MyGO!!!!!</p>
</footer>

<style>
  .Footer {
    margin-top: auto;
    padding: 20px;
    text-align: center;
    background-color: #0c0c10;
    box-shadow: inset 0 4px 0 0 rgba(0, 0, 0, 0.5);
    font-size: 0.85rem;
  }

  .Footer-clubs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .club.cyan {
    color: #00ffff;
  }

  .club.coal {
    color: var(--club-coal);
  }

  .Footer p {
    margin: 0;
    opacity: 0.55;
  }

  .Footer p.Footer-team {
    margin-top: 6px;
  }
</style>
