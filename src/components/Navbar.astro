---
import AuthStatus from "../react/AuthStatus";
import { SITE_CONFIG } from "../config/site";

/**
 * 导航栏。视觉不再手写浮雕阴影：链接直接复用组件库的 .Button + 变体类，
 * 与站点其它按钮完全同源（- 38 行自定义 CSS）。
 * 当前页 = Button_primary + .is-current，靠「更大一号」表达，见 global.css。
 */
const links = [
  { href: "/", label: "主页", icon: "/img/items/grass_block.png" },
  { href: "/lottery", label: "随机组队", icon: "/img/items/tnt.png" },
  { href: "/gallery", label: "晒图提交", icon: "/img/items/ender_pearl.png" },
];
const path =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : "/";
const isAuthCallback = path === "/auth/callback";
---

<nav class="Navbar">
  <a class="Navbar-logo" href="/">
    <img
      src="/img/items/crafting_table.png"
      alt=""
      width="26"
      height="26"
      class="pixel"
    />
    <span class="Navbar-name">{SITE_CONFIG.name}</span>
    <small>{SITE_CONFIG.coHost}</small>
  </a>

  <div class="Navbar-links">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "Button",
            "mc-navlink",
            path === l.href ? "Button_primary is-current" : "Button_secondary",
          ]}
        >
          <img src={l.icon} alt="" width="20" height="20" class="pixel" />
          {l.label}
        </a>
      ))
    }

    {!isAuthCallback && <AuthStatus client:load />}

    <button
      type="button"
      class="Button Button_clear MuteBtn"
      data-mute-toggle
      aria-label="切换按钮音效"
    >
      <img src="/img/items/note_block.png" alt="" width="20" height="20" class="pixel" />
      <span class="MuteOn">音效:开</span>
      <span class="MuteOff">已静音</span>
    </button>
  </div>
</nav>

<style>
  .Navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 20px;
    background-color: rgba(20, 20, 25, 0.92);
    box-shadow:
      inset 0 -4px 0 0 rgba(0, 0, 0, 0.5),
      0 4px 0 0 rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
  }

  .Navbar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-color);
    font-size: 1.15rem;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
    white-space: nowrap;
  }

  .Navbar-logo small {
    font-size: 0.72rem;
    opacity: 0.6;
    letter-spacing: 1px;
  }

  .Navbar-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    /* 当前页按钮是这一行最高的元素。钉住行高，避免在「没有当前页」的页面
       （/me、/admin、/404 等）导航栏忽然变矮 —— 点导航时高度不该跳。 */
    min-height: 54px;
  }

  .MuteBtn {
    gap: 6px;
    padding: 8px 10px;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .MuteBtn img {
    width: 16px;
    height: 16px;
  }

  .MuteOff {
    display: none;
    color: var(--club-coal);
  }

  /* 静音态：由 click-sound.ts 在 <html> 上维护 sound-muted */
  :global(html.sound-muted) .MuteOn {
    display: none;
  }

  :global(html.sound-muted) .MuteOff {
    display: inline;
  }

  :global(html.sound-muted) .MuteBtn img {
    filter: grayscale(1) brightness(0.55);
  }

  @media (max-width: 860px) {
    .Navbar {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .Navbar-logo {
      justify-content: center;
    }

    .Navbar-logo small {
      display: none;
    }

    .Navbar-links {
      justify-content: center;
      gap: 6px;
      min-height: 50px;
    }

    .Navbar-links :global(.Button) {
      padding: 6px 10px;
      font-size: 0.85rem;
    }

    /* 窄屏整体压缩，但当前页仍保留一档尺寸差 */
    .Navbar-links :global(.mc-navlink.is-current) {
      padding: 10px 16px;
      font-size: 1.05rem;
    }

    .Navbar-links :global(.mc-navlink.is-current) :global(img) {
      width: 22px;
      height: 22px;
    }
  }
</style>
