---
const links = [
  { href: "/", label: "主页", icon: "/img/items/grass_block.png" },
  { href: "/register", label: "登记处", icon: "/img/items/diamond.png" },
  { href: "/lottery", label: "随机组队", icon: "/img/items/tnt.png" },
  { href: "/gallery", label: "晒图提交", icon: "/img/items/ender_pearl.png" },
];
const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : "/";
---

<nav class="Navbar">
  <a class="Navbar-logo" href="/">
    <img src="/img/items/crafting_table.png" alt="" width="26" height="26" class="pixel" />
    <span>MC 联谊</span>
    <small>电脑技术协会 × 山商煤炭社</small>
  </a>
  <div class="Navbar-links">
    {
      links.map((l) => (
        <a href={l.href} class:list={["Navbar-link", { current: path === l.href }]}>
          <img src={l.icon} alt="" width="20" height="20" class="pixel" />
          {l.label}
        </a>
      ))
    }
    <button type="button" class="MuteBtn" data-mute-toggle aria-label="切换音效">
      <img src="/img/items/note_block.png" alt="" width="20" height="20" class="pixel" />
      <span class="MuteOn">音效:开</span>
      <span class="MuteOff">已静音</span>
    </button>
  </div>
</nav>

<style>
  .Navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 20px;
    background-color: rgba(20, 20, 25, 0.92);
    box-shadow:
      inset 0 -4px 0 0 rgba(0, 0, 0, 0.5),
      0 4px 0 0 rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
  }

  .Navbar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-color);
    font-size: 1.15rem;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
  }

  .Navbar-logo small {
    font-size: 0.72rem;
    opacity: 0.6;
    letter-spacing: 1px;
  }

  .Navbar-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .Navbar-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    text-decoration: none;
    color: var(--text-color);
    background-color: var(--midground-color);
    font-size: 0.95rem;
    box-shadow:
      inset 0 -3px 0 0 rgba(0, 0, 0, 0.45),
      inset -3px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 3px 0 0 rgba(255, 255, 255, 0.16),
      inset 3px 0 0 0 rgba(255, 255, 255, 0.16);
    transition: background-color 0.15s;
  }

  .Navbar-link:hover {
    background-color: var(--primary-color);
  }

  .Navbar-link.current {
    background-color: var(--primary-color-dark);
    box-shadow:
      inset 0 3px 0 0 rgba(0, 0, 0, 0.45),
      inset 3px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 -3px 0 0 rgba(255, 255, 255, 0.16),
      inset -3px 0 0 0 rgba(255, 255, 255, 0.16);
  }

  .MuteBtn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: none;
    cursor: pointer;
    color: var(--text-color);
    background-color: var(--midground-color);
    font-family: var(--pixel-font);
    font-size: 0.95rem;
    box-shadow:
      inset 0 -3px 0 0 rgba(0, 0, 0, 0.45),
      inset -3px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 3px 0 0 rgba(255, 255, 255, 0.16),
      inset 3px 0 0 0 rgba(255, 255, 255, 0.16);
  }

  .MuteBtn:hover {
    background-color: var(--accent-color);
  }

  .MuteOff {
    display: none;
    color: #ffb040;
  }

  html.sound-muted .MuteOn {
    display: none;
  }

  html.sound-muted .MuteOff {
    display: inline;
  }

  html.sound-muted .MuteBtn img {
    filter: grayscale(1) brightness(0.55);
  }

  html.sound-muted .MuteBtn {
    box-shadow:
      inset 0 3px 0 0 rgba(0, 0, 0, 0.45),
      inset 3px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 -3px 0 0 rgba(255, 255, 255, 0.16),
      inset -3px 0 0 0 rgba(255, 255, 255, 0.16);
  }

  @media (max-width: 768px) {
    .Navbar {
      flex-direction: column;
    }

    .Navbar-logo small {
      display: none;
    }
  }
</style>
