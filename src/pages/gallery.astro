---
import Layout from "../layouts/Layout.astro";
import ScreenshotUploader from "../react/ScreenshotUploader";
import ShowcaseGallery from "../react/ShowcaseGallery";
---

<Layout title="摄影展 · 晒出你的高光 · MC 联谊嘉年华">
  <div class="page-header">
    <img src="/img/items/ender_pearl.png" alt="" class="pixel" />
    <div>
      <h1>摄影展 · 晒出你的高光</h1>
      <p>登录后即可提交报名时登记的 MC ID 的精彩截图，我们会选优秀作品放进展区</p>
    </div>
  </div>

  <ScreenshotUploader client:load />

  <h2 class="section-title">
    <img src="/img/items/golden_apple.png" alt="" class="pixel" />
    风采展示区
  </h2>
  <ShowcaseGallery client:load />
</Layout>

<style is:global>
  .ShowcaseGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ShowcaseCard {
    padding: 12px;
    text-align: center;
    animation: popIn 0.3s ease-out;
  }

  .ShowcaseArt {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    background:
      repeating-conic-gradient(#20202a 0% 25%, #26262f 0% 50%) 0 0 / 16px 16px;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  /* 等比缩放：完整显示图片、不裁剪不拉伸，空隙由像素棋盘底填充 */
  .ShowcaseArt img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .ShowcaseTitle {
    font-size: 1rem;
    color: var(--club-ctech);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
  }

  .ShowcaseCaption {
    margin: 6px 0 0;
    font-size: 0.82rem;
    opacity: 0.7;
    line-height: 1.6;
    word-break: break-all;
  }
</style>

<style is:global>
  .DropZone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 40px 20px;
    text-align: center;
    cursor: pointer;
    border: 3px dashed rgba(255, 255, 255, 0.35);
    box-shadow:
      inset 0 -4px 0 0 rgba(0, 0, 0, 0.45),
      inset -4px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 4px 0 0 rgba(255, 255, 255, 0.16),
      inset 4px 0 0 0 rgba(255, 255, 255, 0.16);
    transition: border-color 0.15s, background-color 0.15s;
  }

  .DropZone span {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .DropZone.over {
    border-color: var(--club-ctech);
    background-color: rgba(80, 173, 46, 0.12);
  }

  .Notice {
    margin: 14px 0 0;
    color: var(--club-coal);
    font-size: 0.9rem;
  }

  .ShotGrid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ShotCard {
    position: relative;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: popIn 0.25s ease-out;
  }

  .ShotCard img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    background: #101016;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.5);
  }

  .ShotRemove {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 26px;
    height: 26px;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.65);
  }

  .ShotRemove:hover {
    background: #c33;
  }

  .SubmitRow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  .SubmitOk {
    color: var(--club-ctech);
    font-size: 0.95rem;
  }

  .SubmitError {
    margin: 14px 0 0;
    color: #ff8383;
    font-size: 0.9rem;
  }

  .ResultList {
    margin: 16px 0 4px;
    padding: 0;
    list-style: none;
    text-align: left;
    font-size: 0.85rem;
  }

  .ResultList li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    word-break: break-all;
  }

  .ResultIndex {
    color: var(--club-ctech);
    flex-shrink: 0;
  }

  .ResultList a {
    color: var(--text-color);
    text-decoration: none;
  }

  .ResultList a:hover {
    color: var(--club-coal);
  }
</style>
