---
import Layout from "../layouts/Layout.astro";
import ScreenshotUploader from "../react/ScreenshotUploader";
import ShowcaseGallery from "../react/ShowcaseGallery";
import { SITE_CONFIG } from "../config/site";
---

<Layout title={`摄影展 · 晒出你的高光 · ${SITE_CONFIG.name}`}>
  <div class="page-header">
    <img src="/img/items/ender_pearl.png" alt="" class="pixel" />
    <div>
      <h1>摄影展 · 晒出你的高光</h1>
      <p>风采展示对所有访客开放浏览；登录并报名后即可提交你的精彩截图</p>
    </div>
  </div>

  <ScreenshotUploader client:load />

  <h2 class="section-title">
    <img src="/img/items/golden_apple.png" alt="" class="pixel" />
    风采展示区
  </h2>
  <ShowcaseGallery client:load />
</Layout>

<style is:global>
  .ShowcaseGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ShowcaseCard {
    padding: 12px;
    text-align: center;
    animation: popIn 0.3s ease-out;
  }

  .ShowcaseArt {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    background:
      repeating-conic-gradient(#20202a 0% 25%, #26262f 0% 50%) 0 0 / 16px 16px;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  /* 等比缩放：完整显示图片、不裁剪不拉伸，空隙由像素棋盘底填充 */
  .ShowcaseArt img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .ShowcaseMeta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ShowcaseId {
    font-size: 0.72rem;
    line-height: 1;
    color: var(--club-coal);
    background: #0c0c10;
    padding: 4px 8px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.12);
  }

  .ShowcaseTitle {
    font-size: 1rem;
    color: var(--club-ctech);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
  }

  /* 管理员可见的学号后缀（服务端判定，普通访客拿不到该字段）；配色与 ShowcaseCaption 一致 */
  .ShowcaseSid {
    font-size: 0.85rem;
    color: var(--text-color);
    text-shadow: none;
    opacity: 0.75;
  }

  .ShowcaseCaption {
    margin: 6px 0 0;
    font-size: 0.82rem;
    opacity: 0.7;
    line-height: 1.6;
    word-break: break-all;
  }

  /* 卡片缩略图可点击进入灯箱 */
  .ShowcaseArtImg {
    cursor: zoom-in;
    transition: transform 0.15s;
  }
  .ShowcaseArtImg:hover {
    transform: scale(1.04);
  }

  /* ===== 灯箱（大图预览） ===== */
  .Lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(8, 8, 12, 0.88);
    animation: fadeIn 0.15s ease-out;
  }
  .LightboxBody {
    margin: 0;
    max-width: min(92vw, 1100px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .LightboxBody img {
    max-width: 100%;
    max-height: 74vh;
    object-fit: contain;
    margin: 0 auto;
    background:
      repeating-conic-gradient(#20202a 0% 25%, #26262f 0% 50%) 0 0 / 24px 24px;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.18), 0 12px 48px rgba(0, 0, 0, 0.6);
  }
  .LightboxBody figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--text-color);
    font-size: 0.95rem;
  }
  .LightboxCaption {
    opacity: 0.8;
    max-width: 60%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .LightboxCount {
    opacity: 0.6;
    font-size: 0.85rem;
  }
  .LightboxClose {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 40px;
    height: 40px;
    font-size: 1.6rem;
    line-height: 1;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
  }
  .LightboxClose:hover {
    background: #c33;
  }
  .LightboxNav {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    font-size: 1.8rem;
    line-height: 1;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
  }
  .LightboxNav:hover {
    border-color: var(--club-ctech);
    background: rgba(80, 173, 46, 0.25);
  }
  .LightboxPrev {
    margin-right: 12px;
  }
  .LightboxNext {
    margin-left: 12px;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<style is:global>
  .DropZone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 40px 20px;
    text-align: center;
    cursor: pointer;
    border: 3px dashed rgba(255, 255, 255, 0.35);
    box-shadow:
      inset 0 -4px 0 0 rgba(0, 0, 0, 0.45),
      inset -4px 0 0 0 rgba(0, 0, 0, 0.45),
      inset 0 4px 0 0 rgba(255, 255, 255, 0.16),
      inset 4px 0 0 0 rgba(255, 255, 255, 0.16);
    transition: border-color 0.15s, background-color 0.15s;
  }

  .DropZone span {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .DropZone.over {
    border-color: var(--club-ctech);
    background-color: rgba(80, 173, 46, 0.12);
  }

  .Notice {
    margin: 14px 0 0;
    color: var(--club-coal);
    font-size: 0.9rem;
  }

  .ShotGrid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .ShotCard {
    position: relative;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: popIn 0.25s ease-out;
  }

  .ShotCard img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    background: #101016;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.5);
  }

  .ShotRemove {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 26px;
    height: 26px;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.65);
  }

  .ShotRemove:hover {
    background: #c33;
  }

  .SubmitRow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  .SubmitOk {
    color: var(--club-ctech);
    font-size: 0.95rem;
  }

  .SubmitError {
    margin: 14px 0 0;
    color: #ff8383;
    font-size: 0.9rem;
  }

  .ResultList {
    margin: 16px 0 4px;
    padding: 0;
    list-style: none;
    text-align: left;
    font-size: 0.85rem;
  }

  .ResultList li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    word-break: break-all;
  }

  .ResultIndex {
    color: var(--club-ctech);
    flex-shrink: 0;
  }

  .ResultList a {
    color: var(--text-color);
    text-decoration: none;
  }

  .ResultList a:hover {
    color: var(--club-coal);
  }

  /* 提交成功面板：结果缩略图（点击可看原图） */
  .ResultThumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 16px 0 4px;
  }
  .ResultThumbs a {
    position: relative;
    display: block;
    width: 96px;
    height: 72px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: #101016;
  }
  .ResultThumbs a:hover {
    border-color: var(--club-ctech);
  }
  .ResultThumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ResultThumbs span {
    position: absolute;
    left: 2px;
    bottom: 2px;
    padding: 1px 5px;
    font-size: 0.68rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
  }

  .SuccessActions a {
    text-decoration: none;
  }
</style>
