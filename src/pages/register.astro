---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../react/RegisterForm";
---

<Layout title="勇者报名 · MC 联谊嘉年华">
  <div class="page-header">
    <img src="/img/items/diamond.png" alt="" class="pixel" />
    <div>
      <h1>勇者报名</h1>
      <p>填写信息加入联谊名单，草稿实时自动保存，随时关闭页面都不会丢</p>
    </div>
  </div>

  <div class="RegisterWrap mc-panel">
    <RegisterForm client:load />
  </div>
</Layout>

<style>
  .RegisterWrap {
    max-width: 720px;
    margin: 0 auto;
  }
</style>

<style is:global>
  .FormMeta {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .FormGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .Field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.95rem;
  }

  .Field-wide {
    grid-column: 1 / -1;
  }

  .RegisterForm > .Field {
    margin-top: 18px;
  }

  .SubmitRow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .SubmitHint {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .SubmitError {
    margin: 14px 0 0;
    color: #ff8383;
    font-size: 0.9rem;
  }

  .SuccessPanel {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    animation: popIn 0.35s ease-out;
  }

  .SuccessPanel h2 {
    margin: 16px 0 8px;
    letter-spacing: 2px;
  }

  .SuccessHint {
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .SuccessActions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .SuccessActions a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .FormGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
