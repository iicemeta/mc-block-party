---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../react/RegisterForm";
---

<Layout title="登记处 · MC 联谊嘉年华">
  <div class="page-header">
    <img src="/img/items/diamond.png" alt="" class="pixel" />
    <div>
      <h1>登记处</h1>
      <p>登录后报名 / 修改报名信息——信息与账号绑定，随时登录即可找回，无需保存任何凭证</p>
    </div>
  </div>

  <div class="RegisterWrap mc-panel">
    <RegisterForm client:load />
  </div>
</Layout>

<style>
  .RegisterWrap {
    max-width: 720px;
    margin: 0 auto;
  }
</style>

<style is:global>
  .FormMeta {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .FormGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .Field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.95rem;
  }

  .Field-wide {
    grid-column: 1 / -1;
  }

  .RegisterForm > .Field {
    margin-top: 18px;
  }

  .SubmitRow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .SubmitHint {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .SubmitError {
    margin: 14px 0 0;
    color: #ff8383;
    font-size: 0.9rem;
  }

  .ModifyRow {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 12px;
    margin-bottom: 20px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.08);
    font-size: 0.88rem;
  }

  .ModifyRow .Input,
  .ModifyRow input {
    flex: 1;
    min-width: 240px;
  }

  .RecordMessage {
    margin: -8px 0 16px;
    font-size: 0.85rem;
    color: var(--club-coal);
  }

  .AuthBindNote {
    font-size: 0.9rem;
    color: var(--club-coal);
    line-height: 1.7;
  }

  .SuccessPanel {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    animation: popIn 0.35s ease-out;
  }

  .SuccessPanel h2 {
    margin: 16px 0 8px;
    letter-spacing: 2px;
  }

  .SuccessHint {
    font-size: 0.85rem;
    opacity: 0.65;
  }

  .SuccessActions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .SuccessActions a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .FormGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
