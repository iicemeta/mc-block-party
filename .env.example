# =====================================================================
# 环境变量说明（复制本文件为 .env 供本地开发，勿提交；生产配置见下）
#
# 变量分两类：
# 1. 前端变量（PUBLIC_ 前缀）：Astro 构建时注入到页面代码，本地写在 .env；
#    生产环境在 Cloudflare Pages 控制台 → Settings → Environment variables 配置。
# 2. 后端变量（functions/ 目录的 Pages Functions 运行时读取）：
#    astro dev 不会运行 Functions，因此 .env 对它们无效。
#    - 生产：Cloudflare Pages 控制台 → Settings → Environment variables
#    - 本地：用 wrangler pages dev 调试 Functions 时写入 .dev.vars（已被 .gitignore 忽略）
#
# 数据库：D1 绑定在 Pages 控制台 → Settings → Functions → D1 bindings 配置
# （绑定名如 DB），属于平台绑定而非环境变量，后端代码会自动识别绑定。
# =====================================================================

# ---------------- 前端（PUBLIC_* · .env） ----------------

# melody auth 服务地址（例如 https://auth.example.com，结尾不带斜杠）
PUBLIC_MCAUTH_SERVER_URI=

# melody auth Admin Panel 中为本站创建的 SPA 应用的 clientId
PUBLIC_MCAUTH_CLIENT_ID=

# 本站对外访问的基址（结尾不带斜杠；本地开发默认 http://localhost:4321，
# 生产为 https://<你的域名>），用于拼接登录回跳 /auth/callback 与登出跳转
PUBLIC_SITE_URI=http://localhost:4321

# ---------------- 后端（Pages Functions · Pages 控制台 / .dev.vars） ----------------

# melody auth 服务地址（服务端 JWT 验签与 userinfo 拉取用，通常与 PUBLIC_MCAUTH_SERVER_URI 相同）
MCAUTH_SERVER_URI=

# melody auth SPA 应用的 clientId（服务端校验 JWT 的 azp，通常与 PUBLIC_MCAUTH_CLIENT_ID 相同）
MCAUTH_CLIENT_ID=

# 超级管理员引导邮箱（该邮箱登录本站并同步后自动晋升为超级管理员；留空则角色完全由数据库管理）
SUPER_ADMIN_EMAIL=

# 图床上游接口地址（完整 https 接口地址；后端以 POST multipart 提交 file 字段，
# 期望响应 { code: 200, url: "..." }）
IMG_UPLOAD_URL=

# ---------------- 预留（代码已支持、暂未接线） ----------------

# Cloudflare Turnstile 人机验证：服务端密钥与允许的域名列表
# （启用报名/晒图防刷时取消注释并填写，前端配套组件见 src/react/Turnstile.tsx）
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=
