# =====================================================================
# 环境变量说明（本文件仅为模板演示，值已清空；生产构建变量见 .env.production，
# 本地开发复制本文件为 .env 填入值，勿提交）
#
# 变量分两类：
# 1. 前端变量（PUBLIC_ 前缀）：Astro 构建时注入到页面代码，只在构建时生效。
#    生产值已提交在 .env.production（astro build 自动加载）；本地开发写在 .env。
# 2. 后端变量（Worker 运行时读取，src/server 与 src/pages/api 使用），
#    与 .env 无关：
#    - 生产：非敏感变量写在 wrangler.jsonc 的 vars（已填好，迁移自原
#      Pages 仪表盘）；敏感变量用 `wrangler secret put <名称>` 设置
#    - 本地：npm run dev（astro dev，经 @astrojs/cloudflare 的 workerd
#      运行时）读取项目根目录的 .dev.vars（已被 .gitignore 忽略），
#      未配置时回退到 wrangler.jsonc vars 的值
#
# 数据库：D1 绑定在 wrangler.jsonc 的 d1_databases 配置（绑定名 DB），
# 属于平台绑定而非环境变量；Worker 代码通过 env.DB 访问
# （src/server/_lib.ts 的 resolveD1 会自动识别绑定）。
# =====================================================================

# ---------------- 前端（PUBLIC_* · .env，仅构建时生效） ----------------

# melody auth 服务地址（例如 https://auth.example.com，结尾不带斜杠）
PUBLIC_MCAUTH_SERVER_URI=

# melody auth Admin Panel 中为本站创建的 SPA 应用的 clientId
PUBLIC_MCAUTH_CLIENT_ID=

# 本站对外访问的基址（结尾不带斜杠；本地开发默认 http://localhost:4321，
# 生产为 https://<你的域名>），用于拼接登录回跳 /auth/callback 与登出跳转
PUBLIC_SITE_URI=http://localhost:4321

# ---------------- 后端（Worker 运行时 · wrangler.jsonc vars / wrangler secret put / .dev.vars） ----------------

# melody auth 服务地址（服务端 JWT 验签与 userinfo 拉取用，通常与 PUBLIC_MCAUTH_SERVER_URI 相同）
# 位置：wrangler.jsonc vars
# MCAUTH_SERVER_URI=https://auth.iicemeta.com

# melody auth SPA 应用的 clientId（服务端校验 JWT 的 azp，通常与 PUBLIC_MCAUTH_CLIENT_ID 相同）
# 位置：wrangler.jsonc vars
# MCAUTH_CLIENT_ID=

# 超级管理员引导邮箱（该邮箱登录本站并同步后自动晋升为超级管理员；留空则角色完全由数据库管理）
# 位置：wrangler.jsonc vars
# SUPER_ADMIN_EMAIL=

# 位置：wrangler.jsonc vars（图片 URL 本就公开展示在风采墙，无需保密）
# IMG_UPLOAD_URL=https://official-img.iicemeta.com

# ---------------- 预留（代码已支持、暂未接线） ----------------

# Cloudflare Turnstile 人机验证：服务端密钥与允许的域名列表
# （启用报名/晒图防刷时用 wrangler secret put 设置，前端配套组件见 src/react/Turnstile.tsx）
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=
